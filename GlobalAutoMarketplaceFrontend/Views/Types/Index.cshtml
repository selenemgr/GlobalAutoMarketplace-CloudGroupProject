@model GlobalAutoMarketplaceFrontend.Models.HomeViewModel

@{
    ViewData["Title"] = "Vehicle Types";

    var vehicleTypes = ViewBag.VehicleTypes as List<GlobalAutoMarketplaceFrontend.Models.VehicleType>;

    // Group cars by vehicle type name
    var carsByType = Model.Cars
        .GroupBy(c => c.TypeName)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div id="loading" style="display:none;">
    <p>Loading cars...</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="filter-area">
    <div class="filter-area-buttons">
        <!-- Edit Mode Switch -->
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="editToggle" onchange="toggleEditMode()">
            <label class="form-check-label" for="editToggle">Edit Mode</label>
        </div>

        <!-- Add New Vehicle Type -->
        <button type="button" class="btn btn-outline-success btn-md" onclick="openAddTypeModal()">
            Add New Type
        </button>
    </div>
</div>


<div class="brand-grid" id="types-container">
    @foreach (var type in vehicleTypes)
    {
        <div class="brand-card">

            <div class="brand-card-header">
                <div class="d-flex gap-2 align-items-center">
                    <div class="d-flex gap-2 align-items-center">
                        <h2 class="brand-title">@type.TypeName</h2>
                        <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" onclick="openEditPatchTypeModal('@type.VehicleTypeId', 'TypeName', '@type.TypeName')">
                            <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                        </button>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <p class="no-cars">@type.Description</p>
                        <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" onclick="openEditPatchTypeModal('@type.VehicleTypeId', 'Description', '@type.Description')">
                            <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                        </button>
                    </div>
                </div>

                <!-- Options menu -->
                <div class="dropdown">
                    <button class="btn btn-light btn-sm m-0" type="button" data-bs-toggle="dropdown">⋮</button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item"
                                    onclick="openEditPutTypeModal('@type.VehicleTypeId', '@type.TypeName', '@type.Description')">
                                Edit
                            </button>
                        </li>

                        <li>
                            <button class="dropdown-item text-danger"
                                    onclick="openDeleteTypeModal('@type.VehicleTypeId', '@type.TypeName')">
                                Delete
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Cars for this type -->
            <div class="car-mini-grid">
                @if (carsByType.ContainsKey(type.TypeName))
                {
                    foreach (var car in carsByType[type.TypeName])
                    {
                        <div class="car-mini-card">
                            <h4>
                                <a class="car-title-link" asp-controller="Cars" asp-action="Details" asp-route-carId="@car.CarId">
                                    @car.Model
                                </a>
                            </h4>

                            <p><strong>Year:</strong> @car.Year</p>
                            <p><strong>Brand:</strong> @car.BrandName</p>
                            <p><strong>Price:</strong> $@car.Price</p>

                            <div class="d-flex gap-2">
                                <p><strong>Color:</strong> @car.Color</p>
                                <div class="color-dot" style="background-color:@car.Color;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="no-cars">No cars available for this vehicle type.</p>
                }
            </div>

        </div>
    }
</div>


<!-- ADD TYPE MODAL -->
<div class="modal fade" id="addTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Types" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Vehicle Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label>Type Name</label>
                    <input name="TypeName" id="newTypeName" class="form-control" required />

                    <label>Description</label>
                    <input name="Description" id="newTypeDescription" class="form-control" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Type</button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- PATCH TYPE MODAL -->
<div class="modal fade" id="editPatchTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Types" asp-action="EditPatch" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Quick Edit Vehicle Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input id="editPatchTypeId" name="TypeId" type="hidden">
                    <input id="editPatchFieldName" name="FieldName" type="hidden">

                    <label id="editPatchLabel"></label>
                    <input id="editPatchFieldValue" name="NewValue" class="form-control" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>

        </div>
    </div>
</div>



<!-- PUT TYPE MODAL -->
<div class="modal fade" id="editPutTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Types" asp-action="EditPut" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Vehicle Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input id="editPutTypeId" name="TypeId" type="hidden">

                    <label>Type Name</label>
                    <input id="editPutTypeName" name="NewTypeName" class="form-control" required />

                    <label>Description</label>
                    <input id="editPutTypeDescription" name="newDescription" class="form-control" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- DELETE TYPE MODAL -->
<div class="modal fade" id="deleteTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Types" asp-action="Delete" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Vehicle Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input id="deleteTypeId" name="VehicleTypeId" type="hidden">

                    <p id="deleteTypeMessage">
                        Are you sure you want to delete this vehicle type?
                        <strong>All related cars will be deleted.</strong>
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>

        </div>
    </div>
</div>


<script>
    function openAddTypeModal() {
        document.getElementById("newTypeName").value = "";
        document.getElementById("newTypeDescription").value = "";
        new bootstrap.Modal(document.getElementById("addTypeModal")).show();
    }

    function openEditPatchTypeModal(id, fieldName, currentValue) {
        document.getElementById("editPatchTypeId").value = id;
        document.getElementById("editPatchFieldName").value = fieldName;
        document.getElementById("editPatchFieldValue").value = currentValue;

        document.getElementById("editPatchLabel").innerText =
            fieldName === "TypeName" ? "New Type Name" : "New Description";

        new bootstrap.Modal(document.getElementById("editPatchTypeModal")).show();
    }


    function openEditPutTypeModal(id, name, description) {
        document.getElementById("editPutTypeId").value = id;
        document.getElementById("editPutTypeName").value = name;
        document.getElementById("editPutTypeDescription").value = description;
        new bootstrap.Modal(document.getElementById("editPutTypeModal")).show();
    }

    function openDeleteTypeModal(id, name) {
        document.getElementById("deleteTypeId").value = id;
        document.getElementById("deleteTypeMessage").innerHTML =
            `Are you sure you want to delete <strong>${name}</strong>?<br><br>
             <strong>All cars associated with this type will also be deleted.</strong>`;
        new bootstrap.Modal(document.getElementById("deleteTypeModal")).show();
    }

    function toggleEditMode() {
        const isChecked = document.getElementById("editToggle").checked;
        document.querySelectorAll(".edit-field-btn").forEach(btn => {
            btn.style.display = isChecked ? "inline-flex" : "none";
        });
    }
</script>

<style>

    .filter-area {
        display: flex;
        justify-content: end;
        align-items: center;
        margin-bottom: 5px;
    }

    .filter-area-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        align-content: center;
        gap: 15px;
    }

    .brand-grid {
        display: grid;
        grid-template-columns: grid-template-columns: 1fr;
        gap: 25px;
        margin-top: 20px;
    }

    .brand-card {
        border: 2px solid #ccc;
        padding: 20px;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 10px 10px 20px -15px #CF5D01;
    }

    .brand-card-header {
        display: flex;
        justify-content: space-between;
    }

    .brand-title {
        margin-bottom: 15px;
        color: #333;
    }

    .car-mini-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 15px;
    }

    .car-mini-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        background: #fafafa;
        transition: transform 0.2s;
    }

    .car-mini-card:hover {
        transform: scale(1.03);
    }

    .car-title-link {
        text-decoration: none;
        color: inherit;
    }

    .car-title-link:hover {
        color: orange;
    }

    .no-cars {
        font-style: italic;
        color: #777;
    }

    .color-dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 1px solid #ccc;
        margin-top: 5px;
    }


</style>

