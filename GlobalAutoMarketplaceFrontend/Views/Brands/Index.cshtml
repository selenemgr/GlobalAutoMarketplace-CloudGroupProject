@{
    ViewData["Title"] = "Brands";

    var brands = ViewBag.Brands as List<GlobalAutoMarketplaceFrontend.Models.Brand>;

    // Group cars by brand
    var carsByBrand = Model.Cars
        .GroupBy(c => c.BrandName)
        .ToDictionary(g => g.Key, g => g.ToList());
}

@model GlobalAutoMarketplaceFrontend.Models.HomeViewModel

<div id="loading" style="display:none;">
    <p>Loading cars...</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="filter-area">
    @await Component.InvokeAsync("BrandTypeFilter")

    <!-- Add New Brand Button -->
    <button type="button" class="btn btn-success btn-md" onclick="openAddBrandModal()">
        Add New Brand
    </button>
</div>

<div class="brand-grid" id="brands-container">
    @foreach (var brand in brands)
    {
        <div class="brand-card">

            <div class="brand-card-header">
                <h2 class="brand-title">@brand.Bname</h2>

                <!-- Three dots menu -->
                <div class="dropdown">
                    <button class="btn btn-light btn-sm m-0" type="button" data-bs-toggle="dropdown">
                        ⋮
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item"
                                    onclick="openEditBrandModal('@brand.BrandId', '@brand.Bname')">
                                Edit
                            </button>
                        </li>

                        <li>
                            <button class="dropdown-item text-danger"
                                    onclick="openDeleteBrandModal('@brand.BrandId', '@brand.Bname')">
                                Delete
                            </button>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="car-mini-grid">
                @if (carsByBrand.ContainsKey(brand.Bname))
                {
                    foreach (var car in carsByBrand[brand.Bname])
                    {
                        <div class="car-mini-card">

                            <h4>
                                <a class="car-title-link" asp-controller="Cars" asp-action="Details" asp-route-carId="@car.CarId">
                                    @car.Model
                                </a>
                            </h4>

                            <p><strong>Year:</strong> @car.Year</p>
                            <p><strong>Type:</strong> @car.TypeName</p>
                            <p><strong>Price:</strong> $@car.Price</p>

                            <div class="d-flex gap-2">
                                <p><strong>Color:</strong> @car.Color</p>
                                <div class="color-dot" style="background-color:@car.Color;"></div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <p class="no-cars">No cars available for this brand.</p>
                }
            </div>

        </div>
    }
</div>

<!-- Add New Brand Modal -->
<div class="modal fade" id="addBrandModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Brands" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label for="newBrandName">Brand Name</label>
                    <input id="newBrandName" name="Bname" class="form-control" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        Add Brand
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- Edit Modal -->
<div class="modal fade" id="editBrandModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Brands" asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input id="editBrandId" name="BrandId" type="hidden">

                    <label>Brand Name</label>
                    <input id="editBrandName" name="NewName" class="form-control" required />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>



<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteBrandModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-controller="Brands" asp-action="Delete" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Brand</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input id="deleteBrandId" name="BrandId" type="hidden">

                    <p id="deleteBrandMessage">
                        Are you sure you want to delete this brand?
                        <strong>All cars associated with this brand will also be deleted.</strong>
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<script>
    document.getElementById("loading").style.display = "block";

    window.addEventListener("load", function() {
        document.getElementById("loading").style.display = "none";
        document.getElementById("cards-container").style.display = "block";
    });

    function openAddBrandModal() {
        document.getElementById("newBrandName").value = ""; // clear previous input
        var modal = new bootstrap.Modal(document.getElementById("addBrandModal"));
        modal.show();
    }


    function openEditBrandModal(brandId, brandName) {
        document.getElementById("editBrandId").value = brandId;
        document.getElementById("editBrandName").value = brandName;

        var modal = new bootstrap.Modal(document.getElementById("editBrandModal"));
        modal.show();
    }

    function openDeleteBrandModal(brandId, brandName) {
        document.getElementById("deleteBrandId").value = brandId;
        document.getElementById("deleteBrandMessage").innerHTML =
            `Are you sure you want to delete <strong>${brandName}</strong>?
             <br><br>
             <strong>All cars associated with this brand will also be deleted.</strong>`;

        var modal = new bootstrap.Modal(document.getElementById("deleteBrandModal"));
        modal.show();
    }
</script>

<style>

    .filter-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .brand-grid {
        display: grid;
        grid-template-columns: grid-template-columns: 1fr;
        gap: 25px;
        margin-top: 20px;
    }

    .brand-card {
        border: 2px solid #ccc;
        padding: 20px;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 10px 10px 20px -15px #CF5D01;
    }

    .brand-card-header {
        display: flex;
        justify-content: space-between;
    }

    .brand-title {
        margin-bottom: 15px;
        color: #333;
    }

    .car-mini-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 15px;
    }

    .car-mini-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        background: #fafafa;
        transition: transform 0.2s;
    }

    .car-mini-card:hover {
        transform: scale(1.03);
    }

    .car-title-link {
        text-decoration: none;
        color: inherit;
    }

    .car-title-link:hover {
        color: orange;
    }

    .no-cars {
        font-style: italic;
        color: #777;
    }

    .color-dot {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 1px solid #ccc;
        margin-top: 5px;
    }


</style>

