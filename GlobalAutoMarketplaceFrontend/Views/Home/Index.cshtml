@{
    ViewData["Title"] = "Home Page";
}

@model GlobalAutoMarketplaceFrontend.Models.HomeViewModel

<div id="loading" style="display:none;">
    <p>Loading cars...</p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="filter-area">
    @await Component.InvokeAsync("TypeFilter")
    <div class="filter-area-buttons">

        <!-- Delete Mode Switch -->
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="deleteToggle" onchange="toggleDeleteMode()">
            <label class="form-check-label" for="deleteToggle">Delete Mode</label>
        </div>

        <!-- Add New Car Button -->
        <form asp-controller="Cars" asp-action="Create" method="get">
            <button type="submit" class="btn btn-outline-success btn-md">
                Add New Car
            </button>
        </form>

    </div>
</div>

<div id="cards-container">
    <div class="card-grid">
        @foreach (var car in Model.Cars)
        {
            <div class="car-card" >
                <div class="car-card-header">
                    <h3>
                        <a class="car-title-link" asp-controller="Cars" asp-action="Details" asp-route-carId="@car.CarId">
                            @car.BrandName @car.Model
                        </a>
                    </h3>

                    <button class="btn btn-danger btn-sm delete-btn" onclick="openDeleteModal(@car.CarId)" style="display:none;">
                        <strong style="margin: 5px;">X</strong>
                    </button>
                </div>

                <div class="car-info">
                    <p><strong>Year:</strong> @car.Year</p>
                    <p><strong>Type:</strong> @car.TypeName</p>
                    <p><strong>Price:</strong> $@car.Price</p>
                    <div class="d-flex gap-2">
                        <p>
                            <strong>Color: </strong>@car.Color
                        </p>
                        <div class="color-dot" style="background-color:@car.Color;"></div>
                    </div>
                        
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete this car?</p>
            </div>

            <div class="modal-footer">
                <form asp-controller="Cars" asp-action="Delete" method="post">
                    <input id="deleteId" name="carId" type="hidden" />

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    document.getElementById("loading").style.display = "block";

    window.addEventListener("load", function() {
        document.getElementById("loading").style.display = "none";
        document.getElementById("cards-container").style.display = "block";
    });

    function openDeleteModal(id) {
        document.getElementById("deleteId").value = id;

        var myModal = new bootstrap.Modal(document.getElementById("deleteModal"));
        myModal.show();
    }

    function toggleDeleteMode() {
        const isChecked = document.getElementById("deleteToggle").checked;
        const deleteButtons = document.querySelectorAll(".delete-btn");

        deleteButtons.forEach(btn => {
            btn.style.display = isChecked ? "block" : "none";
        });
    }
</script>

<style>
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .car-card {
        border: 2px solid #ddd;
        box-shadow: 15px 15px 20px -20px #CF5D01;
        border-radius: 10px;
        padding: 15px;
        gap: 5px;
        background: white;
        display: flex;
        flex-direction: column;
    }

    .car-title-link {
        color: inherit; 
        text-decoration: none; 
        display: inline-block; 
    }

    .car-title-link:hover {
        color: orange; 
    }

    .car-card-header {
        display: flex;
        justify-content: space-between;
    }

    .car-info {
        justify-content: flex-end;
        margin-top: auto;
    }

    .filter-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .filter-area-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        align-content: center;
        gap: 15px;
    }

    .delete-btn {
        transition: opacity 0.25s ease-in-out;
    }

    .form-check-input:checked {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.15rem #dc3545;
    }

    .color-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 1px solid #ccc;
        margin-top: 3px;
    }

</style>

