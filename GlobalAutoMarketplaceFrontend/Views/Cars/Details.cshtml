@model GlobalAutoMarketplaceFrontend.Models.CarDetails

@{
    ViewData["Title"] = "Car Details";

    var iconFile = $"{Model.VehicleType.TypeName?.ToLower().Replace(" ", "-")}.png";

    var iconPath = Url.Content($"~/public/vehicle-types-icons/{iconFile}");

    var carTypes = ViewBag.CarTypes as List<GlobalAutoMarketplaceFrontend.Models.VehicleType>;
    var brands = ViewBag.Brands as List<GlobalAutoMarketplaceFrontend.Models.Brand>;

    var colors = new List<string> {
        "White", "Black", "Red", "Blue", "Green", "Yellow", "Orange",
        "Purple", "Gray", "Silver", "Pink", "Brown", "Cyan", "Magenta"
    };

    var currentYear = DateTime.Now.Year;
    var years = Enumerable.Range(1990, currentYear - 1990 + 1).Reverse();
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="details-card" style="box-shadow: 5px 5px 20px @Model.Color">
    <div class="filter-area">
        <h2>@Model.Brand.Bname @Model.Model (@Model.Year)</h2>
        <div class="filter-area-buttons">

            <!-- Edit Mode Switch -->
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="editToggle" onchange="toggleEditMode()">
                <label class="form-check-label" for="editToggle">Edit Mode</label>
            </div>

            <!-- Edit All Button -->
            <button type="button" class="btn btn-light btn-md" data-bs-toggle="modal" data-bs-target="#editAllModal">
                <img src="~/public/edit.png" alt="Edit Icon" style="width:16px; height:16px;" />
            </button>

        </div>
    </div>

    <div class="details-grid">
        <div class="details-left">
            <div class="attribute-container">
                <p><strong>Brand:</strong> @Model.Brand.Bname</p>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="BrandId" data-value="@Model.Brand.BrandId">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
            <div class="attribute-container">
                <p><strong>Model:</strong> @Model.Model</p>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="Model" data-value="@Model.Model">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
            <div class="attribute-container">
                <p><strong>Year:</strong> @Model.Year</p>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="Year" data-value="@Model.Year">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
            <div class="d-flex gap-2">
                <p>
                    <strong>Color: </strong>@Model.Color
                </p>
                <div class="color-dot" style="background-color:@Model.Color;"></div>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="Color" data-value="@Model.Color">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
            <div class="attribute-container">
                <p><strong>Price:</strong> $@Model.Price</p>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="Price" data-value="@Model.Price">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
        </div>

        <div class="details-right">
            <div class="attribute-container">
                <p><strong>Vehicle Type:</strong> @Model.VehicleType.TypeName</p>
                <button class="btn btn-sm btn-light edit-field-btn" style="display:none;" data-field="VehicleTypeId" data-value="@Model.VehicleType.VehicleTypeId">
                    <img src="~/public/edit.png" alt="Edit Icon" style="width:12px; height:12px;" />
                </button>
            </div>
            <img src="@iconPath" class="vehicle-icon" alt="@Model.VehicleType.TypeName icon" />

            <p><strong>VIN:</strong> @Model.VIN</p>
            <p><strong>Description:</strong> @Model.VehicleType.Description</p>
        </div>
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
        Back to Cars
    </a>
</div>

<!-- Edit Attribute Modal -->
<div class="modal fade" id="editFieldModal" tabindex="-1" aria-labelledby="editFieldModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="patchFieldForm" asp-action="PatchField" asp-controller="Cars" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editFieldModalLabel">Edit Field</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="carId" value="@Model.CarId" />
                    <input type="hidden" id="modalFieldName" name="fieldName" />
                    <div id="modalInputContainer"></div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit All Modal -->
<div class="modal fade" id="editAllModal" tabindex="-1" aria-labelledby="editAllModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Cars" asp-action="EditFull" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editAllModalLabel">Edit All Fields</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="carId" value="@Model.CarId" />

                    <div class="row g-3">

                        <!-- Brand -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Brand</label>
                            <select name="updatedCar.BrandId" class="form-select">
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.BrandId" selected="@(brand.BrandId == Model.Brand.BrandId ? true : null)">
                                        @brand.Bname
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- MODEL -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Model</label>
                            <input type="text" name="updatedCar.Model" class="form-control" value="@Model.Model" />
                        </div>

                        <!-- YEAR -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Year</label>
                            <select name="updatedCar.Year" class="form-select">
                                @foreach (var year in years)
                                {
                                    <option value="@year" selected="@(year == Model.Year ? true : null)">@year</option>
                                }
                            </select>
                        </div>

                        <!-- COLOR -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Color</label>
                            <select name="updatedCar.Color" class="form-select">
                                @foreach (var color in colors)
                                {
                                    <option value="@color" selected="@(color == Model.Color ? true : null)">@color</option>
                                }
                            </select>
                        </div>

                        <!-- PRICE -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="updatedCar.Price"
                                       class="form-control"
                                       step="0.01" min="0.01" max="1000000"
                                       value="@Model.Price" />
                            </div>
                        </div>

                        <!-- VEHICLE TYPE -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Vehicle Type</label>
                            <select name="updatedCar.VehicleTypeId" class="form-select">
                                @foreach (var carType in carTypes)
                                {
                                    <option value="@carType.VehicleTypeId" selected="@(carType.VehicleTypeId == Model.VehicleType.VehicleTypeId ? true : null)">
                                        @carType.TypeName
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- VIN -->
                        <input style="display: none" type="text" name="updatedCar.VIN" class="form-control" value="@Model.VIN" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>

            </form>
        </div>
    </div>
</div>


<script>
   function toggleEditMode() {
        const isChecked = document.getElementById("editToggle").checked;
        const editButtons = document.querySelectorAll(".edit-field-btn");

         editButtons.forEach(btn => {
            btn.style.display = isChecked ? "flex" : "none";
        });
    }

    const colorsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(colors));
    const brandsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(brands));
    const carTypesList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(carTypes));
    const yearsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(years));


    document.querySelectorAll(".edit-field-btn").forEach(btn => {
        btn.addEventListener("click", function() {
            const field = this.dataset.field;
            const value = this.dataset.value;
            const inputContainer = document.getElementById("modalInputContainer");
            const modalFieldName = document.getElementById("modalFieldName");

            modalFieldName.value = field;
            let inputHtml = "";

            if (field.toLowerCase() === "color") {
                inputHtml = `<select name="newValue" class="form-select">`;
                 colorsList.forEach(color => {
                    inputHtml += `<option value="${color}"${value === color ? " selected" : ""}>${color}</option>`;
                });
                inputHtml += `</select>`;
            }
            else if (field.toLowerCase() === "brandid") {
                inputHtml = `<select name="newValue" class="form-select">`;
                brandsList.forEach(brand => {
                    inputHtml += `<option value="${brand.BrandId}"${value == brand.BrandId ? " selected" : ""}>${brand.Bname}</option>`;
                });
                inputHtml += `</select>`;
            }
            else if (field.toLowerCase() === "vehicletypeid") {
                inputHtml = `<select name="newValue" class="form-select">`;
                carTypesList.forEach(type => {
                    inputHtml += `<option value="${type.VehicleTypeId}"${value == type.VehicleTypeId ? " selected" : ""}>${type.TypeName}</option>`;
                });
                inputHtml += `</select>`;
            }
            else if (field.toLowerCase() === "year") {
                inputHtml = `<select name="newValue" class="form-select">`;
                yearsList.forEach(year => {
                    inputHtml += `<option value="${year}"${value == year ? " selected" : ""}>${year}</option>`;
                });
                inputHtml += `</select>`;
            } 
            else if (field.toLowerCase() === "price") {
                inputHtml = `<div class="input-group mb-3">`
                inputHtml += `<div class="input-group-prepend">`;
                inputHtml += `<span class="input-group-text">$</span>`;
                inputHtml += `</div>`;
                inputHtml += `<input type="number" name="newValue" value="${value}" step="0.01" min="0.01" max="1000000" class="form-control" />`;
                inputHtml += `</div>`;
             }
             else {
                inputHtml = `<input type="text" name="newValue" value="${value}" class="form-control" />`;
            }

            inputContainer.innerHTML = inputHtml;
            var modal = new bootstrap.Modal(document.getElementById('editFieldModal'));
            modal.show();
        });
    });
</script>

<style>
    .details-card {
        border: 2px solid #ddd;
        border-radius: 10px;
        padding: 20px;
        background: white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 15px;
    }

    .details-left, .details-right {
        border: 1px solid #eee;
        padding: 15px;
        border-radius: 8px;
    }

    h2 {
        margin-bottom: 15px;
    }

    .color-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 1px solid #ccc;
        margin-top: 3px;
    }

    .vehicle-icon {
        width: 120px;
        height: 120px;
        object-fit: contain;
        margin-top: -30px;
    }

    .filter-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .filter-area-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        align-content: center;
        gap: 15px;
    }

    .form-check-input:checked {
        background-color: #FF6803 !important;
        border-color: #FF6803 !important;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.10rem #FF6803;
    }

    .attribute-container {
        display: flex;
        gap: 10px;
    }

    .edit-field-btn {
        height: 20px;
        width: 20px;
        margin-top: -15px;
        align-self: center;
        justify-content: center;
    }
</style>
